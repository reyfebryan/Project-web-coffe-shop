import java.util.Scanner;

public class NilaiMahasiswa {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);

        // Input data
        System.out.print("Masukkan jumlah kehadiran (maks 16): ");
        int kehadiran = input.nextInt();

        System.out.print("Masukkan nilai tugas (0-100): ");
        double tugas = input.nextDouble();

        System.out.print("Masukkan nilai UTS (0-100): ");
        double uts = input.nextDouble();

        System.out.print("Masukkan nilai UAS (0-100): ");
        double uas = input.nextDouble();

        // Hitung nilai kehadiran (dikonversi ke 100 dulu)
        double nilaiKehadiran = (kehadiran / 16.0) * 100;

        // Hitung nilai berbobot
        double nKehadiran = nilaiKehadiran * 0.10;
        double nTugas = tugas * 0.20;
        double nUTS = uts * 0.30;
        double nUAS = uas * 0.40;

        // Nilai akhir
        double nilaiAngka = nKehadiran + nTugas + nUTS + nUAS;

        // Konversi nilai huruf
        char nilaiHuruf;
        if (nilaiAngka >= 80) {
            nilaiHuruf = 'A';
        } else if (nilaiAngka >= 68) {
            nilaiHuruf = 'B';
        } else if (nilaiAngka >= 56) {
            nilaiHuruf = 'C';
        } else if (nilaiAngka >= 45) {
            nilaiHuruf = 'D';
        } else {
            nilaiHuruf = 'E';
        }

        // Output
        System.out.println("\n=== HASIL ===");
        System.out.println("Jumlah Kehadiran : " + kehadiran);
        System.out.println("Nilai Tugas      : " + tugas);
        System.out.println("Nilai UTS        : " + uts);
        System.out.println("Nilai UAS        : " + uas);
        System.out.println("Nilai Kehadiran  : " + nKehadiran);
        System.out.println("Nilai Tugas (20%): " + nTugas);
        System.out.println("Nilai UTS (30%)  : " + nUTS);
        System.out.println("Nilai UAS (40%)  : " + nUAS);
        System.out.println("Nilai Angka      : " + nilaiAngka);
        System.out.println("Nilai Huruf      : " + nilaiHuruf);
    }
}